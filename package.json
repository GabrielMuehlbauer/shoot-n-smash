{
  "name": "shoot-n-smash",
  "version": "0.25.0-beta.1",
  "private": true,
  "description": "Jogo 3D no navegador com estilingue, ondas, itens e ranking global.",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "db:migrate": "npm run db:migrate --workspace server",
    "build": "npm run build --workspace client",
    "check:bundle": "node scripts/check-build-budget.js",
    "start": "npm run start --workspace server",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run test && npm run build && npm run check:bundle"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "vite": "^8.2.2"
  }
}
